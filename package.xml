<?xml version="1.0"?>
<package format="3">
  <name>sicktoolbox_wrapper</name>
  <version>2.5.4</version>
  <description>ROS 2 wrapper for the sicktoolbox library to interface with SICK LMS2xx lasers.</description>

  <maintainer email="chadrockey@gmail.com">Chad Rockey</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>rclcpp</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>sicktoolbox</build_depend>
  <build_depend>diagnostic_updater</build_depend>

  <exec_depend>rclcpp</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>sicktoolbox</exec_depend>
  <exec_depend>diagnostic_updater</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

